# 敏感数据（绝对不能提交）
repos/
ref/
context/
.workbuddy/
*.db
*.db-wal
*.db-shm
key_*.txt
*recovery-codes*
cookies*.json
.env
.env.local

# 依赖与构建产物
node_modules/
dist/
release/
out/
build/
out-dist/
# 打包时换个输出目录躲开 safe-delete（旧目录删不掉时用），别让 100 MB 的 exe 进仓库
out-dist*/
.tmp/
__pycache__/
*.pyc
.venv/
venv/

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
*.tmp

# 对标库调试产物（页面快照、截图、临时链接表，体积大且可重跑）
output/bench/*.html
output/bench/*.png
output/bench/tmp*.txt
output/bench/one.txt
output/bench/sk.txt
output/bench/baidu.html
output/bench/links.json
output/bench/search-links.json

# 体验包及其压缩包是本地生成的分发物（几百 MB），走 Release / 网盘 / U 盘，不进仓库。
# 但那份去掉了私人数据的示例库要留着，别人 clone 下来不用重采也能看效果。
output/知枢-体验包/
output/*.zip
!output/知枢-示例数据-zhishu.db
